NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
BCRYPT_COST=12
AUTO_ACTIVATE_ACCOUNTS=true

# Google Cloud OAuth Web Client settings; leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A unique initial admin. Change this before first startup.
SEED_ADMIN_EMAIL=admin@school.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
